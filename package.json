{
  "name": "distributed-wagering-processor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.0",
  "engines": {
    "bun": ">=1.0.0 <2.0.0"
  },
  "scripts": {
    "build": "bun node_modules/typescript/bin/tsc -p tsconfig.build.json --incremental false",
    "start": "bun dist/main.js",
    "start:dev": "bun --watch src/main.ts",
    "migration:create": "bun node_modules/@mikro-orm/cli/cli.js migration:create",
    "migration:up": "bun node_modules/@mikro-orm/cli/cli.js migration:up",
    "migration:down": "bun node_modules/@mikro-orm/cli/cli.js migration:down",
    "migration:status": "bun node_modules/@mikro-orm/cli/cli.js migration:list",
    "test": "bun test",
    "test:unit": "bun test test/unit --pass-with-no-tests",
    "test:integration": "bun scripts/run-bun-test-suite.mjs integration",
    "test:integration:financial": "BUN_RUNTIME_TRANSPILER_CACHE_PATH=0 bun --smol test test/integration/financial-persistence.integration.spec.ts --pass-with-no-tests --parallel=1",
    "test:integration:infrastructure": "BUN_RUNTIME_TRANSPILER_CACHE_PATH=0 bun --smol test test/integration/infrastructure.integration.spec.ts --pass-with-no-tests --parallel=1",
    "test:integration:outbox": "BUN_RUNTIME_TRANSPILER_CACHE_PATH=0 bun --smol test test/integration/outbox-processing.integration.spec.ts --pass-with-no-tests --parallel=1",
    "test:integration:sns": "BUN_RUNTIME_TRANSPILER_CACHE_PATH=0 bun --smol test test/integration/outbox-sns.integration.spec.ts --pass-with-no-tests --parallel=1",
    "test:integration:sqs": "BUN_RUNTIME_TRANSPILER_CACHE_PATH=0 bun --smol test test/integration/sqs-wager-processing.integration.spec.ts --pass-with-no-tests --parallel=1",
    "test:integration:idempotency": "BUN_RUNTIME_TRANSPILER_CACHE_PATH=0 bun --smol test test/integration/wager-idempotency.integration.spec.ts --pass-with-no-tests --parallel=1",
    "test:integration:wagering": "BUN_RUNTIME_TRANSPILER_CACHE_PATH=0 bun --smol test test/integration/wager-processing.integration.spec.ts --pass-with-no-tests --parallel=1",
    "test:integration:reversals": "BUN_RUNTIME_TRANSPILER_CACHE_PATH=0 bun --smol test test/integration/wager-reversals.integration.spec.ts --pass-with-no-tests --parallel=1",
    "test:integration:observability": "BUN_RUNTIME_TRANSPILER_CACHE_PATH=0 bun --smol test test/integration/reconciliation-observability.integration.spec.ts --pass-with-no-tests --parallel=1",
    "test:concurrency": "bun scripts/run-bun-test-suite.mjs concurrency",
    "test:concurrency:inbox": "BUN_RUNTIME_TRANSPILER_CACHE_PATH=0 bun --smol test test/concurrency/inbox-processing.concurrency.spec.ts --pass-with-no-tests --parallel=1",
    "test:concurrency:outbox": "BUN_RUNTIME_TRANSPILER_CACHE_PATH=0 bun --smol test test/concurrency/outbox-publisher.concurrency.spec.ts --pass-with-no-tests --parallel=1",
    "test:concurrency:wagering": "BUN_RUNTIME_TRANSPILER_CACHE_PATH=0 bun --smol test test/concurrency/wager-processing.concurrency.spec.ts --pass-with-no-tests --parallel=1",
    "test:concurrency:reversals": "BUN_RUNTIME_TRANSPILER_CACHE_PATH=0 bun --smol test test/concurrency/wager-reversals.concurrency.spec.ts --pass-with-no-tests --parallel=1",
    "test:concurrency:reconciliation": "BUN_RUNTIME_TRANSPILER_CACHE_PATH=0 bun --smol test test/concurrency/reconciliation-observability.concurrency.spec.ts --pass-with-no-tests --parallel=1",
    "test:all": "bun run test:unit && bun run test:integration && bun run test:concurrency",
    "test:distributed": "bun scripts/run-final.ts",
    "test:final": "bun scripts/run-final.ts --full"
  },
  "dependencies": {
    "@aws-sdk/client-sns": "^3.1126.0",
    "@aws-sdk/client-sqs": "^3.1126.0",
    "@mikro-orm/core": "^7.1.15",
    "@mikro-orm/decorators": "^7.1.15",
    "@mikro-orm/migrations": "^7.1.15",
    "@mikro-orm/nestjs": "^7.1.0",
    "@mikro-orm/postgresql": "^7.1.15",
    "@nestjs/common": "^12.0.1",
    "@nestjs/config": "^12.0.0",
    "@nestjs/core": "^12.0.1",
    "@nestjs/platform-express": "^12.0.1",
    "@nestjs/schedule": "^12.0.1",
    "@nestjs/terminus": "^12.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "decimal.js": "^10.6.0",
    "dotenv": "^17.4.2",
    "nestjs-pino": "^5.1.0",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@mikro-orm/cli": "7.1.15",
    "@nestjs/cli": "^12.0.0",
    "@types/bun": "^1.4.0",
    "@types/node": "^26.4.1",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.13",
    "typescript": "^6.0.0"
  },
  "mikro-orm": {
    "configPaths": [
      "./src/persistence/mikro-orm/mikro-orm.config.ts",
      "./dist/persistence/mikro-orm/mikro-orm.config.js"
    ],
    "preferTs": true,
    "tsLoader": "tsx"
  }
}
