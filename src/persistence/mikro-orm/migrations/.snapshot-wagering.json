      "checks": [
        {
          "name": "wager_transactions_amount_non_negative_check",
          "expression": "amount >= 0",
          "definition": "check (amount >= 0)"
        },
        {
          "name": "wager_transactions_currency_check",
          "expression": "currency ~ '^[A-Z]{3}$'",
          "definition": "check (currency ~ '^[A-Z]{3}$')"
        },
        {
          "name": "wager_transactions_failure_code_check",
          "expression": "(failure_code IS NULL) OR (failure_code = ANY (ARRAY['INSUFFICIENT_FUNDS'::text, 'CURRENCY_MISMATCH'::text, 'REFERENCE_NOT_FOUND'::text, 'INVALID_REFERENCE'::text, 'REFERENCE_ALREADY_REVERSED'::text, 'REVERSAL_AMOUNT_MISMATCH'::text, 'REVERSAL_WOULD_MAKE_BALANCE_NEGATIVE'::text, 'PERMANENT_INFRASTRUCTURE_FAILURE'::text]))",
          "definition": "check ((failure_code IS NULL) OR (failure_code = ANY (ARRAY['INSUFFICIENT_FUNDS'::text, 'CURRENCY_MISMATCH'::text, 'REFERENCE_NOT_FOUND'::text, 'INVALID_REFERENCE'::text, 'REFERENCE_ALREADY_REVERSED'::text, 'REVERSAL_AMOUNT_MISMATCH'::text, 'REVERSAL_WOULD_MAKE_BALANCE_NEGATIVE'::text, 'PERMANENT_INFRASTRUCTURE_FAILURE'::text])))"
        },
        {
          "name": "wager_transactions_kind_check",
          "expression": "kind in ('OPENING', 'BET', 'WIN', 'LOSS', 'REFUND', 'ROLLBACK')",
          "definition": "check (kind in ('OPENING', 'BET', 'WIN', 'LOSS', 'REFUND', 'ROLLBACK'))"
        },
        {
          "name": "wager_transactions_processed_at_check",
          "expression": "(status = 'PROCESSED') = (processed_at is not null)",
          "definition": "check ((status = 'PROCESSED') = (processed_at is not null))"
        },
        {
          "name": "wager_transactions_processed_reference_check",
          "expression": "(kind <> ALL (ARRAY['REFUND'::text, 'ROLLBACK'::text])) OR (status <> 'PROCESSED'::text) OR (reference_transaction_id IS NOT NULL)",
          "definition": "check ((kind <> ALL (ARRAY['REFUND'::text, 'ROLLBACK'::text])) OR (status <> 'PROCESSED'::text) OR (reference_transaction_id IS NOT NULL))"
        },
        {
          "name": "wager_transactions_reference_attempt_count_check",
          "expression": "reference_attempt_count >= 0",
          "definition": "check (reference_attempt_count >= 0)"
        },
        {
          "name": "wager_transactions_reference_not_blank_check",
          "expression": "\n    reference_external_transaction_id is null or\n    (length(reference_external_transaction_id) > 0 and btrim(reference_external_transaction_id) = reference_external_transaction_id)\n  ",
          "definition": "check (\n    reference_external_transaction_id is null or\n    (length(reference_external_transaction_id) > 0 and btrim(reference_external_transaction_id) = reference_external_transaction_id)\n  )"
        },
        {
          "name": "wager_transactions_reference_required_check",
          "expression": "(kind <> ALL (ARRAY['REFUND'::text, 'ROLLBACK'::text])) OR (reference_external_transaction_id IS NOT NULL)",
          "definition": "check ((kind <> ALL (ARRAY['REFUND'::text, 'ROLLBACK'::text])) OR (reference_external_transaction_id IS NOT NULL))"
        },
        {
          "name": "wager_transactions_reference_schedule_check",
          "expression": "(status = 'PENDING_REFERENCE' and kind in ('REFUND', 'ROLLBACK') and\n    reference_next_attempt_at is not null and reference_deadline_at is not null and\n    reference_next_attempt_at <= reference_deadline_at) or\n    (status <> 'PENDING_REFERENCE' and reference_next_attempt_at is null and reference_deadline_at is null)",
          "definition": "check ((status = 'PENDING_REFERENCE' and kind in ('REFUND', 'ROLLBACK') and\n    reference_next_attempt_at is not null and reference_deadline_at is not null and\n    reference_next_attempt_at <= reference_deadline_at) or\n    (status <> 'PENDING_REFERENCE' and reference_next_attempt_at is null and reference_deadline_at is null))"
        },
        {
          "name": "wager_transactions_required_fields_check",
          "expression": "\n    length(id) > 0 and btrim(id) = id and\n    length(provider_id) > 0 and btrim(provider_id) = provider_id and\n    length(external_transaction_id) > 0 and btrim(external_transaction_id) = external_transaction_id and\n    length(idempotency_key) > 0 and btrim(idempotency_key) = idempotency_key and\n    length(payload_hash) > 0 and btrim(payload_hash) = payload_hash and\n    length(player_id) > 0 and btrim(player_id) = player_id and\n    length(round_id) > 0 and btrim(round_id) = round_id and\n    length(game_id) > 0 and btrim(game_id) = game_id\n  ",
          "definition": "check (\n    length(id) > 0 and btrim(id) = id and\n    length(provider_id) > 0 and btrim(provider_id) = provider_id and\n    length(external_transaction_id) > 0 and btrim(external_transaction_id) = external_transaction_id and\n    length(idempotency_key) > 0 and btrim(idempotency_key) = idempotency_key and\n    length(payload_hash) > 0 and btrim(payload_hash) = payload_hash and\n    length(player_id) > 0 and btrim(player_id) = player_id and\n    length(round_id) > 0 and btrim(round_id) = round_id and\n    length(game_id) > 0 and btrim(game_id) = game_id\n  )"
        },
        {
          "name": "wager_transactions_result_all_or_none_check",
          "expression": "(result_balance_amount is null and result_balance_currency is null and result_wallet_version is null) or\n    (result_balance_amount is not null and result_balance_currency is not null and result_wallet_version is not null)",
          "definition": "check ((result_balance_amount is null and result_balance_currency is null and result_wallet_version is null) or\n    (result_balance_amount is not null and result_balance_currency is not null and result_wallet_version is not null))"
        },
        {
          "name": "wager_transactions_result_balance_check",
          "expression": "result_balance_amount >= 0 and result_balance_amount <> 'NaN'::numeric",
          "definition": "check (result_balance_amount >= 0 and result_balance_amount <> 'NaN'::numeric)"
        },
        {
          "name": "wager_transactions_result_currency_check",
          "expression": "result_balance_currency ~ '^[A-Z]{3}$'",
          "definition": "check (result_balance_currency ~ '^[A-Z]{3}$')"
        },
        {
          "name": "wager_transactions_result_version_check",
          "expression": "result_wallet_version >= 1",
          "definition": "check (result_wallet_version >= 1)"
        },
        {
          "name": "wager_transactions_status_check",
          "expression": "status in ('PENDING', 'PENDING_REFERENCE', 'PROCESSED', 'REJECTED', 'FAILED')",
          "definition": "check (status in ('PENDING', 'PENDING_REFERENCE', 'PROCESSED', 'REJECTED', 'FAILED'))"
        },
        {
          "name": "wager_transactions_terminal_failure_check",
          "expression": "(status in ('REJECTED', 'FAILED')) = (failure_code is not null)",
          "definition": "check ((status in ('REJECTED', 'FAILED')) = (failure_code is not null))"
        }
